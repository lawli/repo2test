# apitest credentials for the example profiles. Auto-loaded by the `apitest` CLI; shell env
# vars (export FOO=...) override these. Copy to .env and fill in real values.
# .env is gitignored — never commit real credentials. Profiles refuse literal credentials.
# Names follow <PROFILE>_<SERVICE>_DB_USER/_DB_PASS and <PROFILE>_MQ_USER/_MQ_PASS.
LOCAL_EXAMPLE_DB_USER=changeme
LOCAL_EXAMPLE_DB_PASS=changeme
LOCAL_EXAMPLE_PAYMENT_DB_USER=changeme
LOCAL_EXAMPLE_PAYMENT_DB_PASS=changeme
LOCAL_MQ_USER=guest
LOCAL_MQ_PASS=guest
STAGING_EXAMPLE_DB_USER=changeme
STAGING_EXAMPLE_DB_PASS=changeme
STAGING_EXAMPLE_PAYMENT_DB_USER=changeme
STAGING_EXAMPLE_PAYMENT_DB_PASS=changeme
STAGING_MQ_USER=guest
STAGING_MQ_PASS=guest
EXAMPLE_EXAMPLE_DB_USER=changeme
EXAMPLE_EXAMPLE_DB_PASS=changeme
EXAMPLE_EXAMPLE_PAYMENT_DB_USER=changeme
EXAMPLE_EXAMPLE_PAYMENT_DB_PASS=changeme
EXAMPLE_MQ_USER=guest
EXAMPLE_MQ_PASS=guest
